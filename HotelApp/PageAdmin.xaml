<Page x:Class="HotelApp.PageAdmin" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Админ" Loaded="Page_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ШАПКА -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Управление номерами" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Выйти" Width="100" Margin="20,0,0,0" Background="#E74C3C" Click="btnLogout_Click"/>
        </StackPanel>

        <!-- ТАБЛИЦА -->
        <DataGrid Grid.Row="1" x:Name="dgRooms" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgRooms_SelectionChanged" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="80"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding RoomCategories.Name}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding PricePerNight}" Width="100"/>
                <DataGridTextColumn Header="Мест" Binding="{Binding Capacity}" Width="80"/>
                <DataGridTextColumn Header="Фото" Binding="{Binding ImagePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ФОРМА ДОБАВЛЕНИЯ/ИЗМЕНЕНИЯ -->
        <Border Grid.Row="2" Background="White" Padding="15" Margin="0,15,0,0" BorderBrush="#CCC" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Строка 1 -->
                    <TextBlock Text="Номер:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <TextBox x:Name="txtRoomNumber" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,15,10"/>

                    <TextBlock Text="Категория:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <ComboBox x:Name="cbRoomType" Grid.Row="0" Grid.Column="3" Height="30" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <!-- Строка 2 -->
                    <TextBlock Text="Цена:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <TextBox x:Name="txtPrice" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,15,10"/>

                    <TextBlock Text="Мест:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <TextBox x:Name="txtCapacity" Grid.Row="1" Grid.Column="3" Height="30" Margin="0,0,0,10"/>

                    <!-- Строка 3 -->
                    <TextBlock Text="Описание:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <TextBox x:Name="txtDesc" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" Margin="0,0,0,10"/>

                    <!-- Строка 4 (Картинка) -->
                    <TextBlock Text="Фото:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,10"/>
                    <Button x:Name="btnLoadImage" Content="Выбрать фото" Grid.Row="3" Grid.Column="1" Height="30" Click="btnLoadImage_Click" Background="#2980B9" Foreground="White" Margin="0,0,15,10"/>
                    <TextBlock x:Name="txtImagePath" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,0,10"/>
                </Grid>

                <!-- КНОПКИ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Добавить" Width="120" Background="#27AE60" Click="btnAdd_Click" Margin="0,0,10,0"/>
                    <Button Content="Изменить" Width="120" Background="#F39C12" Click="btnEdit_Click" Margin="0,0,10,0"/>
                    <Button Content="Удалить" Width="120" Background="#E74C3C" Click="btnDelete_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>