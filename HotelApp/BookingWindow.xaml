<Window x:Class="HotelApp.BookingWindow" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
        Title="Бронирование" Height="550" Width="450" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock x:Name="tbTitle" Text="Бронирование" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- ⭐ ДАТА ЗАЕЗДА (ограничена 10 годами) -->
        <TextBlock Text="Дата заезда:" FontWeight="SemiBold"/>
        <DatePicker x:Name="dpCheckIn" Height="30" Margin="0,5,0,10" SelectedDateChanged="Date_Changed"/>

        <!-- ⭐ ДАТА ВЫЕЗДА (ограничена 10 годами) -->
        <TextBlock Text="Дата выезда:" FontWeight="SemiBold"/>
        <DatePicker x:Name="dpCheckOut" Height="30" Margin="0,5,0,10" SelectedDateChanged="Date_Changed"/>

        <!-- ⭐ ИМЯ ГОСТЯ (автоподстановка) -->
        <TextBlock Text="Имя гостя:" FontWeight="SemiBold"/>
        <TextBox x:Name="txtGuestName" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Паспортные данные:" FontWeight="SemiBold"/>
        <TextBox x:Name="txtPassport" Height="30" Margin="0,5,0,15"/>

        <TextBlock Text="Итоговая стоимость:" FontWeight="Bold"/>
        <TextBlock x:Name="tbTotalPrice" Text="0.00 ₽" FontSize="24" FontWeight="Bold" Foreground="#E74C3C" Margin="0,5,0,15"/>

        <Button Content="Подтвердить бронь" Height="40" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="btnBook_Click"/>
        <Button Content="Отмена" Height="30" Background="#95A5A6" Foreground="White" Click="btnCancel_Click" Margin="0,10,0,0"/>
    </StackPanel>
</Window>