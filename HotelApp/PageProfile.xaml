<Page x:Class="HotelApp.PageProfile" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Профиль" Background="#F5F6FA" Loaded="Page_Loaded">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">
        <TextBlock Text="Личный кабинет" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="ФИО:" FontWeight="SemiBold"/>
        <TextBox x:Name="txtName" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Телефон:" FontWeight="SemiBold"/>
        <TextBox x:Name="txtPhone" Height="30" Margin="0,5,0,10"/>

        <TextBlock Text="Email (логин):" FontWeight="SemiBold"/>
        <TextBox x:Name="txtEmail" Height="30" Margin="0,5,0,20" IsReadOnly="True" Background="#E0E0E0"/>

        <Button Content="Сохранить изменения" Height="35" Click="btnSave_Click" Background="#27AE60" Foreground="White" Margin="0,0,0,10"/>
        <Button Content="Назад в каталог" Height="35" Click="btnBack_Click" Background="#95A5A6" Foreground="White"/>
    </StackPanel>
</Page>