<Page x:Class="HotelApp.PageMyBookings" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Мои брони" Background="#F5F6FA" Loaded="Page_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Мои бронирования" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" x:Name="dgBookings" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding Rooms.Number}" Width="80"/>
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:F2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding BookingStatuses.Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Назад в каталог" Width="150" Click="btnBack_Click" Background="#95A5A6"/>
        </StackPanel>
    </Grid>
</Page>