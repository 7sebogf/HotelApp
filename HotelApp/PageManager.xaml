<Page x:Class="HotelApp.PageManager" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Менеджер" Background="#F5F6FA" Loaded="Page_Loaded">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Все бронирования" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Выйти" Width="100" Margin="20,0,0,0" Background="#E74C3C" Click="btnLogout_Click"/>
        </StackPanel>
        
        <DataGrid Grid.Row="1" x:Name="dgBookings" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="dgBookings_SelectionChanged" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Гость" Binding="{Binding Users.FullName}" Width="150"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Rooms.Number}" Width="80"/>
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckInDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOutDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat={}{0:F2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding BookingStatuses.Name}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Изменить статус:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cbStatus" Width="150" Height="30" Margin="0,0,10,0">
                <ComboBoxItem Content="Новая"/>
                <ComboBoxItem Content="Подтверждена"/>
                <ComboBoxItem Content="Отменена"/>
            </ComboBox>
            <Button Content="Применить" Width="120" Height="30" Background="#F39C12" Click="btnChangeStatus_Click"/>
        </StackPanel>
    </Grid>
</Page>